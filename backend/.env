# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Firebase / Firestore ────────────────────────────────────────
FIREBASE_PROJECT_ID=intranet-arm-dev-70a30
FIREBASE_KEY_FILE=./service-account.json

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_min_32_chars
JWT_ACCESS_TTL=900         # 15 minutos en segundos
JWT_REFRESH_TTL=28800      # 8 horas en segundos

# ── Storage ────────────────────────────────────────────────────
# "local" = disco local (desarrollo) | "gcs" = Google Cloud Storage (producción)
STORAGE=gcs
BACKEND_URL=http://localhost:3001

# ── Google Cloud Storage (solo cuando STORAGE=gcs) ─────────────
GCS_PROJECT_ID=intranet-arm-dev-70a30
GCS_BUCKET_DOCUMENTS=intranet-arm-dev-70a30.firebasestorage.app
GCS_BUCKET_AVATARS=intranet-arm-dev-70a30.firebasestorage.app
GCS_KEY_FILE=./service-account.json

# ── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@empresa.com
SMTP_PASS=CHANGE_ME_smtp_password
EMAIL_FROM="Intranet Corporativa <no-reply@empresa.com>"

# ── Frontend URL (para emails y CORS) ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com → APIs → Credenciales
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# ── Throttle ───────────────────────────────────────────────────
THROTTLE_TTL=60000        # 1 minuto en ms
THROTTLE_LIMIT=100        # requests por ventana
AUTH_THROTTLE_LIMIT=5     # intentos de login por ventana
