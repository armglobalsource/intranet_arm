# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.pgedgsugjpcqwgzvrfrm:T0eabQ332G8KpOWQ@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.pgedgsugjpcqwgzvrfrm:T0eabQ332G8KpOWQ@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_min_32_chars
JWT_ACCESS_TTL=900         # 15 minutos en segundos
JWT_REFRESH_TTL=28800      # 8 horas en segundos

# ── Storage ────────────────────────────────────────────────────
# "local" = disco local (desarrollo) | "gcs" = Google Cloud Storage (producción)
STORAGE=gcs
BACKEND_URL=http://localhost:3001

# ── Google Cloud Storage (solo cuando STORAGE=gcs) ─────────────
GCS_PROJECT_ID=intranet-arm
GCS_BUCKET_DOCUMENTS=intranet-arm.firebasestorage.app
GCS_BUCKET_AVATARS=intranet-arm.firebasestorage.app
GCS_KEY_FILE=./service-account.json

# ── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@empresa.com
SMTP_PASS=CHANGE_ME_smtp_password
EMAIL_FROM="Intranet Corporativa <no-reply@empresa.com>"

# ── Frontend URL (para emails y CORS) ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Throttle ───────────────────────────────────────────────────
THROTTLE_TTL=60000        # 1 minuto en ms
THROTTLE_LIMIT=100        # requests por ventana
AUTH_THROTTLE_LIMIT=5     # intentos de login por ventana
