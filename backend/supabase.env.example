# Copy to .env.supabase for local development. Never commit the filled file.
# Use a dedicated application database role once the operational schema exists.
# Vercel functions: copy the Transaction pooler URI from Supabase Connect.
# Local / long-lived backend: Session pooler or direct connection if reachable.
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres

STORAGE=supabase
SUPABASE_URL=https://kqqufmijfvrgzrfrqsby.supabase.co
# Secret server key from Supabase API Keys. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_PUBLIC=arm-public
SUPABASE_BUCKET_DOCUMENTS=arm-documents
JWT_SECRET=
FRONTEND_URL=https://ecosistema.armglobal.org
# Resend: server-only key and sender on a verified domain. Never NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Set to the verified API deployment URL.
BACKEND_URL=

# Optional PEM CA override. Known Supabase database hosts already use the bundled
# public Supabase CA plus Node's trusted certificates, with verification enabled.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
