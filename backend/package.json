{
  "name": "intranet-backend",
  "version": "0.1.0",
  "description": "Intranet Corporativa — Backend API (NestJS)",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && npx tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:postgres:preview": "ts-node src/main-postgres-preview.ts",
    "test:postgres:identity": "node scripts/test-postgres-identity.cjs",
    "test:postgres:domains": "node scripts/test-postgres-domains.cjs",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:santiago-lideres": "node scripts/seed-santiago-lideres-calendario.js",
    "db:export": "node scripts/supabase-migration/export-firestore.cjs",
    "db:inspect": "node scripts/supabase-migration/inspect-export.cjs",
    "db:prepare-staging": "node scripts/supabase-migration/prepare-staging.cjs",
    "db:check": "node scripts/check-postgres.cjs",
    "test:migration": "node scripts/supabase-migration/export-lib.test.cjs",
    "db:migrate": "echo 'Migración Supabase en preparación: ver ../docs/migracion-supabase.md'",
    "db:seed": "echo 'Seed no aplica — usar scripts/migrate-to-firestore.js'",
    "test:postgres:fichas": "node scripts/test-postgres-fichas.cjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@supabase/supabase-js": "2.118.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "18.0.8",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "joi": "^18.2.1",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "8.23.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0",
    "xlsx": "^0.18.5"
  }
}
